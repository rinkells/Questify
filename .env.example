SECRET_KEY=replace-with-a-local-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web
ADMIN_ALLOWED_IPS=127.0.0.1/32,::1/128
HEALTHCHECK_TOKEN=local-healthcheck-token-not-for-production
POSTGRES_DB=questify
POSTGRES_USER=questify
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/1
GUNICORN_WORKERS=3
QUESTIFY_MAX_FAILED_COMPLETIONS_PER_USER_PER_DAY=100
QUESTIFY_MAX_FAILED_COMPLETIONS_PER_USER=10000

