# Safe by default: DEBUG=False makes Django refuse to start until the values
# below are real production values. docker-compose.dev.yml sets DEBUG=True.
SECRET_KEY=replace-with-a-local-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web
ADMIN_ALLOWED_IPS=127.0.0.1/32,::1/128
HEALTHCHECK_TOKEN=local-healthcheck-token-not-for-production
POSTGRES_DB=questify
POSTGRES_USER=questify
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/1
GUNICORN_WORKERS=3
QUESTIFY_MAX_FAILED_COMPLETIONS_PER_USER_PER_DAY=100
QUESTIFY_MAX_FAILED_COMPLETIONS_PER_USER=10000
# Required when DEBUG=False, deliberately left blank so production must choose:
# number of trusted reverse proxies in front of Django (1 for
# deploy/nginx-questify.conf.example, 0 when reached directly).
# Behind a proxy with 0, all clients share one throttle bucket; with no proxy
# and a value above 0, clients can spoof X-Forwarded-For to dodge rate limits.
DRF_NUM_PROXIES=

# --- Optional settings (defaults shown; uncomment to override) ---
# Defaults to True when DRF_NUM_PROXIES > 0 (trust the proxy's X-Forwarded-Proto).
# USE_HTTPS_PROXY=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# AUTH_TOKEN_TTL_DAYS=30
# QUESTIFY_XP_24H_CAP=1000
# QUESTIFY_MAX_QUESTS_PER_USER=1000
# QUESTIFY_MAX_CATEGORIES_PER_USER=100
# POSTGRES_SSLMODE=verify-full
# POSTGRES_SSLROOTCERT=
# STATIC_ROOT=/tmp/questify-staticfiles
